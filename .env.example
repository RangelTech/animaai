# Exemplo de ambiente do animaai. SÓ NOMES: os valores ficam no Infisical (rt-produtos/animaai, ambiente prod) e chegam à VPS no deploy. Nunca commitar valores.
# Em desenvolvimento local basta copiar para .env e preencher o que for usar; sem SMTP/LLM o app roda em modo de desenvolvimento.

ANIMAAI_ADMIN_KEY=
ANIMAAI_CAKTO_SEGREDO=
ANIMAAI_CHECKOUT_MENSAL=
ANIMAAI_DEMO_SENHA=
ANIMAAI_LLM_KEY=
ANIMAAI_PROXY=
ANIMAAI_SEGREDO_SESSAO=
ANIMAAI_SMTP_FROM=
SMTP_HOST=
SMTP_PASSWORD=
SMTP_PORT=
SMTP_USER=
